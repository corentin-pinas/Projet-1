/* planches réalistes (Servier Medical Art) teintées par l'ambiance */
:root{--frac:#ffffff;--plaque:#ffa078;--plaqueTrait:rgba(255,185,145,.8)}
[data-amb=cafe]{--plaque:#f0d2b4;--plaqueTrait:rgba(240,215,190,.6)}
[data-amb=holo]{--plaque:#3fdcff;--plaqueTrait:rgba(120,230,255,.8)}
[data-amb=aurore]{--plaque:#c8b4ff;--plaqueTrait:rgba(205,190,255,.75)}
[data-amb=amethyste]{--plaque:#e4a5ff;--plaqueTrait:rgba(228,165,255,.8)}
[data-amb=nebuleuse]{--plaque:#8cc8ff;--plaqueTrait:rgba(150,205,255,.8)}
[data-amb=abysses]{--plaque:#aae1ff;--plaqueTrait:rgba(170,225,255,.8)}
.pl .pf{fill:var(--plaque)}
.pl .pt{fill:var(--plaqueTrait)}
.pl[data-pl] [stroke]:not([data-o]){stroke:var(--plaqueTrait);vector-effect:non-scaling-stroke;stroke-width:1.1px}
.pl .zf{filter:drop-shadow(0 0 1.5px var(--c))}
.patients{display:flex;gap:8px;flex-wrap:wrap}
.patients button{font:700 15px var(--texte);color:var(--ink);background:var(--card2);border:1px solid var(--line);border-radius:999px;padding:8px 16px;cursor:pointer;min-height:44px}
.patients button[aria-pressed=true]{background:linear-gradient(120deg,var(--acc),var(--acc2));color:var(--accInk);border-color:transparent}
.zoomwrap{display:grid;gap:6px;width:100%;min-height:0}
.zoomwrap.deux{grid-template-columns:1fr 1fr}.zoomwrap.trois{grid-template-columns:1fr 1fr 1fr}
.zoomwrap>div{display:flex;flex-direction:column;align-items:center;min-height:0}
.zoomwrap svg{flex:1;min-height:380px}
.liste{display:flex;flex-wrap:wrap;gap:6px 10px}
.liste button{display:inline-flex;align-items:center;gap:8px;font:15px var(--texte);color:var(--ink);background:var(--card2);border:1px solid var(--line);border-radius:999px;padding:6px 12px 6px 6px;cursor:pointer;min-height:40px}
.liste .n{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;font-weight:700;font-size:14px;color:#140a10}
.credit{font-size:12px;color:var(--mute);opacity:.8}
.vues{display:flex;gap:4px;padding:4px;border-radius:999px;background:var(--card2);border:1px solid var(--line)}
.vues button{font:700 15px var(--texte);color:var(--mute);background:none;border:0;border-radius:999px;padding:8px 14px;min-height:40px;cursor:pointer}
.vues button[aria-pressed=true]{background:linear-gradient(120deg,var(--acc),var(--acc2));color:var(--accInk)}
.zoomwrap{display:flex;justify-content:center;align-items:stretch;width:100%;min-height:0}
.zoomwrap svg{width:100%;height:100%;min-height:380px;max-height:640px}
.liste .ailleurs{opacity:.6;border-style:dashed}.liste small{color:var(--mute);font-size:13px}
.stat{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:4px 8px}
.courbe{width:min(120px,100%);min-width:70px;height:40px;flex:1 1 70px}
@media (max-width:820px){.vues button{padding:8px 10px;font-size:14px}.courbe{width:100%;height:30px}.stat{flex-direction:column;align-items:flex-start}}
.bulle .signal{display:block;margin-top:10px;background:none;border:0;padding:0;color:var(--mute);font:14px var(--texte);text-decoration:underline;cursor:pointer}
.en-deplacement #vis{cursor:grab;outline:2px dashed var(--acc2);outline-offset:-2px;border-radius:12px;touch-action:none}
.tend{margin-top:6px;font-size:14px;font-weight:700}.tend.bon{color:var(--ok)}.tend.moins{color:var(--work)}.tend small{font-weight:400;color:var(--mute)}
